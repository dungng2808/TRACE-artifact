<Window x:Class="Rq1Experiment.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RQ1 Structural Planning Experiment"
        Width="1420" Height="900" MinWidth="1100" MinHeight="720"
        Background="{StaticResource PageBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" CornerRadius="10" Padding="18" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="RQ1 Experiment Dashboard" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="DIRECT vs PLANNED · WPF .NET 8 · one-screen pipeline" Foreground="#BCC6DD" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#D9E2F6" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="650" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4" IsEnabled="{Binding IsConfigurationEditable}">
                    <TextBlock Text="Experiment" FontWeight="SemiBold" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Width="105" ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}" />
                        <TextBox Text="{Binding ExperimentId, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Java repository" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseRepositoryCommand}" />
                        <TextBox Text="{Binding RepositoryRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Border BorderBrush="#D8DEEA" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,7,0,1"
                            IsEnabled="{Binding IsSmokeMode}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSmokeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Analyze repository"
                                        Command="{Binding AnalyzeSmokeRepositoryCommand}" />
                                <TextBlock Text="Smoke focal method" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Focal class" FontSize="11" Margin="0,4,0,0" />
                            <ComboBox ItemsSource="{Binding SmokeFocalClasses}"
                                      SelectedItem="{Binding SelectedSmokeClass}" />
                            <TextBlock Text="Focal method" FontSize="11" Margin="0,4,0,0" />
                            <ComboBox ItemsSource="{Binding SmokeFocalMethods}"
                                      SelectedItem="{Binding SelectedSmokeMethod}"
                                      DisplayMemberPath="SelectionLabel"
                                      ToolTip="Method có dấu ✕ chỉ được chạy Diagnostic Smoke; kết quả không được dùng cho Pilot/Official." />
                            <TextBlock Text="{Binding SmokeSelectionSummary}" FontSize="10" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="2,3,2,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Experiment output root" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Build module (relative; . = whole repository)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBox Text="{Binding ModulePath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Example: edu.nd.dronology.core. Maven uses -pl &lt;module&gt; -am." />
                    <TextBlock Text="Repetitions (Pilot/Official; Smoke luôn là 1)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBox Text="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Số lần sinh độc lập cho mỗi focal method và mỗi approach." />
                    <TextBlock Text="JDK home (optional; PATH is used when blank)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseJavaHomeCommand}" />
                        <TextBox Text="{Binding JavaHome, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Select the JDK folder that contains bin/java.exe." />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,4" IsEnabled="{Binding IsConfigurationEditable}">
                    <TextBlock Text="LLM provider and exact model" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Providers}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedProviderId}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModels}"
                                  Text="{Binding SelectedModelId, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  ToolTip="Reload the provider list or type an exact model ID manually." />
                        <Button Grid.Column="2" Content="Reload models" Command="{Binding RefreshModelsCommand}" />
                    </Grid>

                    <Border BorderBrush="#D8DEEA" BorderThickness="1" CornerRadius="5"
                            Padding="7" Margin="4,7,4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeepSeekProvider}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="DeepSeek request settings" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Request timeout (seconds)" FontSize="11" />
                                    <TextBox Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Per-call timeout. Allowed range: 30–3,600 seconds; 600 is recommended for DeepSeek Thinking mode." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Thinking mode" FontSize="11" />
                                    <ComboBox ItemsSource="{Binding DeepSeekThinkingModes}"
                                              SelectedItem="{Binding DeepSeekThinkingMode}"
                                              ToolTip="enabled returns reasoning before final JSON; disabled is faster and makes temperature effective." />
                                </StackPanel>
                            </Grid>
                            <TextBlock FontSize="10" Foreground="#B45309" TextWrapping="Wrap" Margin="4,1,4,0"
                                       Text="Changing either value changes the treatment. An existing frozen Official experiment must not be resumed with changed settings; create a new Experiment ID." />
                        </StackPanel>
                    </Border>

                    <Grid Margin="4,7,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max output tokens / API call" FontWeight="SemiBold" />
                            <TextBox Text="{Binding MaxOutputTokensPerCall, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Giới hạn output gửi tới provider. Gemini 3.5 Flash-Lite hỗ trợ tối đa 65,536." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Total token ceiling / run" FontWeight="SemiBold" />
                            <TextBox Text="{Binding TotalTokenCeilingPerRun, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tổng input + output của một DIRECT run hoặc toàn bộ Planner + Generator của một PLANNED run." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="5,2,5,0" FontSize="10" Foreground="#59657A" TextWrapping="Wrap"
                               Text="Mặc định: 65,536. Có thể tăng lên 131,072 hoặc 200,000–262,144 nếu model cần thinking tokens hoặc context lớn. DIRECT và PLANNED chia sẻ cùng trần token mỗi run." />

                    <Grid Margin="4,7,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Parallel LLM runs" FontWeight="SemiBold" />
                            <TextBox Text="{Binding MaxParallelLlmCalls, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Số focal method được gọi LLM đồng thời. Phạm vi 1–32; nên bắt đầu 3–4 để tránh RPM/TPM throttling." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Parallel tool runs" FontWeight="SemiBold" />
                            <TextBox Text="{Binding MaxParallelToolRuns, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Số Maven/Gradle/JUnit/JaCoCo/PIT workspace chạy đồng thời. Phạm vi 1–8; nên dùng 2 nếu RAM dưới 16 GB." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="5,2,5,0" FontSize="10" Foreground="#B45309" TextWrapping="Wrap"
                               Text="Parallelism là một phần của frozen Official configuration. Thay đổi giá trị yêu cầu Experiment ID mới." />

                    <Expander Header="API Keys — one plaintext key per line" IsExpanded="True" Margin="4,7,4,0">
                        <StackPanel>
                            <TextBox Text="{Binding ApiKeysText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" MinLines="4" MaxLines="7"
                                     FontFamily="Consolas" />
                            <DockPanel>
                                <TextBlock Text="{Binding ApiKeyStatus}" VerticalAlignment="Center"
                                           Foreground="#59657A" TextWrapping="Wrap" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Validate format" Command="{Binding ValidateApiKeysCommand}" />
                                    <Button Content="Save keys" Command="{Binding SaveApiKeysCommand}" />
                                    <Button Content="Validate provider setup" Command="{Binding TestProviderConnectionCommand}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Warning: keys are saved unencrypted under the WPF project's data/api-keys folder."
                                       Foreground="#B45309" FontSize="11" Margin="5,2" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="Pipeline control" FontWeight="SemiBold" />
                    <DockPanel Margin="0,2,0,4">
                        <Button DockPanel.Dock="Right" Content="Unlock config" Command="{Binding UnlockConfigurationCommand}"
                                Margin="4,0,0,0" Padding="8,2" Background="#F59E0B" Foreground="White" FontWeight="SemiBold"
                                ToolTip="Mở khóa cấu hình Official để chỉnh sửa Total token ceiling, Max output tokens, API keys hoặc các thiết lập khác" />
                        <TextBlock Text="{Binding ConfigurationLockStatus}" Foreground="#B45309"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,2,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Open" Command="{Binding OpenExperimentCommand}"
                                    ToolTip="Open a saved experiment snapshot. Completed run artifacts are reused." />
                            <Button Content="Delete" Command="{Binding DeleteExperimentCommand}"
                                    ToolTip="Delete the selected experiment after confirmation." />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding KnownExperimentIds}"
                                  SelectedItem="{Binding SelectedExistingExperimentId}"
                                  ToolTip="Existing experiment" />
                    </DockPanel>
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="Load" Command="{Binding LoadCommand}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Validate" Command="{Binding ValidateCommand}" />
                        <Button Content="New experiment" Command="{Binding CreateNewExperimentCommand}"
                                ToolTip="Preserve the locked Official run and create a new editable Smoke/Pilot experiment." />
                    </WrapPanel>
                    <Button Content="▶ RUN FULL PIPELINE" Command="{Binding RunFullPipelineCommand}"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontWeight="Bold" FontSize="14" Height="45" />
                    <TextBlock Text="{Binding RunPrerequisiteMessage}" Foreground="#B45309"
                               TextWrapping="Wrap" Margin="5,2" HorizontalAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Pause after stage" Command="{Binding PauseCommand}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" />
                        <Button Content="Resume" Command="{Binding ResumeCommand}" />
                        <Button Content="Retry failed runs" Command="{Binding RetryFailedRunsCommand}"
                                Background="#4F46E5" Foreground="White" FontWeight="SemiBold"
                                ToolTip="Xóa các run bị lỗi/quá token và chỉ sinh lại các run đó với budget token hiện tại; giữ nguyên các run đã VALID." />
                    </WrapPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress}"
                                 Height="18" Margin="4,8,4,2" />
                    <TextBlock Text="{Binding OverallProgress, StringFormat=Overall progress: {0:F0}%}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Pipeline status" FontWeight="SemiBold" Margin="4,0,4,5" />
                <ItemsControl ItemsSource="{Binding PipelineSteps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D8DEEA" BorderThickness="1" CornerRadius="5" Padding="7" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding State}" Foreground="#4F46E5" TextAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" Margin="0,0,0,10" Height="480" MinHeight="360">
            <TabItem Header="Current runs and evidence">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="230" MinHeight="120" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Runs}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              RowHeight="30" AlternatingRowBackground="#F1F5F9" GridLinesVisibility="Horizontal"
                              BorderBrush="#CBD5E1" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject" Binding="{Binding SubjectId}" Width="110" />
                            <DataGridTextColumn Header="Focal class" Binding="{Binding FocalClass}" Width="1.5*" />
                            <DataGridTextColumn Header="Focal method" Binding="{Binding FocalMethod}" Width="1.3*" />
                            <DataGridTextColumn Header="Approach" Binding="{Binding Approach}" Width="90" />
                            <DataGridTextColumn Header="Rep" Binding="{Binding Repetition}" Width="55" />
                            <DataGridTextColumn Header="Current stage" Binding="{Binding Stage}" Width="130" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" Background="#CBD5E1" />
                    <TextBox Grid.Row="2" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             ToolTip="Live pipeline and evidence log" />
                </Grid>
            </TabItem>
            <TabItem Header="Prompt catalog">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reload prompts"
                                Command="{Binding ReloadPromptsCommand}" Margin="8,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding PromptCatalogStatus}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PromptCatalogLocation}" Foreground="#59657A"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PromptCatalogLocation}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" MinWidth="180" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding PromptFiles}" SelectedItem="{Binding SelectedPromptFile}"
                                 BorderBrush="#CBD5E1" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Kind}" Foreground="#59657A" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Background="#CBD5E1" />
                        <TextBox Grid.Column="2" Text="{Binding SelectedPromptFile.Content, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" Background="#0F172A"
                                 Foreground="#E2E8F0" BorderBrush="#334155"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Phase checklist">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Phases}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                            <DataGridTextColumn Header="Phase" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Completed at" Binding="{Binding CompletedAt}" IsReadOnly="True" Width="190" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                            <DataGridCheckBoxColumn Header="Manual override" Binding="{Binding Overridden}" IsReadOnly="True" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="1">
                        <TextBlock Text="A checkbox tracks progress; it does not replace Exit Gate evidence."
                                   Foreground="#59657A" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Save checklist" Command="{Binding SavePhaseProgressCommand}" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4">
            <TextBlock Text="Phases 2–9 are implemented, including an authoritative rebuildable runs.csv ledger. The controlled Pilot experiment begins in Phase 10."
                       VerticalAlignment="Center" Foreground="#59657A" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open run folder" Click="OpenRunFolder_OnClick" />
                <Button Content="Xem kết quả" Command="{Binding OpenResultsWindowCommand}"
                        Background="#0F766E" Foreground="White" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>

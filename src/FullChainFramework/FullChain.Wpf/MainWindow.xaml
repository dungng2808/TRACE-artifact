<Window x:Class="FullChain.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FullChain.Wpf"
        mc:Ignorable="d"
        Title="FullChainFramework - Research Operator Console" Height="1000" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Status -->
            <RowDefinition Height="Auto" /> <!-- Settings Expander -->
            <RowDefinition Height="Auto" /> <!-- Actions Bar -->
            <RowDefinition Height="190" MinHeight="150" /> <!-- Campaign History -->
            <RowDefinition Height="Auto" /> <!-- Progress HUD -->
            <RowDefinition Height="2*" MinHeight="200" /> <!-- Stages Table & Detail Pane -->
            <RowDefinition Height="5" />    <!-- Splitter -->
            <RowDefinition Height="1*" MinHeight="150" /> <!-- Full Log Viewer -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Status -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FULL-CHAIN OPERATOR" FontWeight="Bold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Dual Accounting: Delivered ITT vs Candidate Diagnostics" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" Width="100" Height="14" Visibility="{Binding IsRunning, Converter={x:Static local:VisibilityHelper.BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Settings Expander -->
        <Expander Grid.Row="1" Header="Toolchain &amp; LLM Configuration (Gitignored Local Store)" IsExpanded="False" Background="White" Padding="8" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Endpoint:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Endpoint, Mode=TwoWay}" Margin="4" Padding="4,2" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Model ID:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ModelId, Mode=TwoWay}" Margin="4" Padding="4,2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApiKey, Mode=TwoWay}" Margin="4" Padding="4,2" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Java Home:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding JavaHome, Mode=TwoWay}" Margin="4" Padding="4,2" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maven Home:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MavenHome, Mode=TwoWay}" Margin="4" Padding="4,2" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="EvoSuite JAR:" VerticalAlignment="Center" Margin="4" />
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EvosuiteJar, Mode=TwoWay}" Margin="4" Padding="4,2" />
            </Grid>
        </Expander>

        <!-- 3. Actions Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Content="Preflight" Command="{Binding PreflightCommand}" Width="90" Height="28" Margin="0,0,8,0" Background="#F1F5F9" FontWeight="SemiBold" />
                    <Button Content="Run One Target" Command="{Binding RunOneTargetCommand}" Width="120" Height="28" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="Target:" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,4,0" />
                    <TextBox Text="{Binding SelectedSubjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="95" Height="28" Padding="5,3" Margin="0,0,8,0" FontFamily="Consolas" />
                    <TextBlock Text="Rep:" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,4,0" />
                    <TextBox Text="{Binding SelectedRepetition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="28" Padding="5,3" Margin="0,0,8,0" />
                    <Button Content="Run Pilot (15)" Command="{Binding RunPilotCommand}" Width="110" Height="28" Margin="0,0,8,0" Background="#0F766E" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Run Official (150)" Command="{Binding RunOfficialCommand}" Width="120" Height="28" Margin="0,0,8,0" Background="#4338CA" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Height="28" Margin="0,0,8,0" Background="#EF4444" Foreground="White" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="NEW CAMPAIGN ID:" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,6,0" />
                    <TextBox Text="{Binding CampaignId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="28" Padding="5,3" Margin="0,0,8,0" FontFamily="Consolas" />
                    <Button Content="New Run ID" Command="{Binding NewRunIdCommand}" Width="95" Height="28" Margin="0,0,8,0" Background="#E0F2FE" />
                    <Button Content="Refresh Runs" Command="{Binding RefreshRunsCommand}" Width="95" Height="28" Margin="0,0,8,0" Background="#E2E8F0" />
                    <Button Content="Resume Selected" Command="{Binding ResumeCommand}" Width="115" Height="28" Margin="0,0,8,0" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Open Run Folder" Command="{Binding OpenRunFolderCommand}" Width="120" Height="28" Margin="0,0,8,0" Background="#E2E8F0" />
                    <Button Content="Open Evidence" Command="{Binding OpenEvidenceCommand}" Width="110" Height="28" Margin="0,0,8,0" Background="#E2E8F0" />
                    <Button Content="Copy Full Log" Command="{Binding CopyLogCommand}" Width="100" Height="28" Background="#E2E8F0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Historical campaign browser. Selecting a row loads its paired results below. -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="CAMPAIGN HISTORY" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left" />
                    <TextBlock Text="Select a run to inspect saved pair-level evidence. B2 = records verified by the RQ3 verifier." FontSize="11" Foreground="#64748B" Margin="14,1,0,0" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Campaign" Binding="{Binding CampaignId}" Width="2*" />
                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated}" Width="125" />
                        <DataGridTextColumn Header="Pairs" Binding="{Binding PairProgress}" Width="65" />
                        <DataGridTextColumn Header="FullChain B2" Binding="{Binding FullChainB2}" Width="90" />
                        <DataGridTextColumn Header="EvoSuite B2" Binding="{Binding EvoSuiteB2}" Width="85" />
                        <DataGridTextColumn Header="Avg. branch coverage" Binding="{Binding AverageBranchCoverage}" Width="175" />
                        <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5. Progress HUD -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <UniformGrid Columns="5">
                <StackPanel Margin="4">
                    <TextBlock Text="PHASE" FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentPhase}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="TARGET PAIR" FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentTargetNumber}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="ACTIVE TREATMENT" FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentTreatment}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="REPAIR ROUND" FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentRepairRound}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="VERDICT" FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentVerdict}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- 6. Stages Table & Detail Pane -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- Stages Table -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                <DataGrid ItemsSource="{Binding StageRows}" SelectedItem="{Binding SelectedStageRow, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetId}" Width="80" />
                        <DataGridTextColumn Header="Rep" Binding="{Binding Repetition}" Width="45" />
                        <DataGridTextColumn Header="Treatment" Binding="{Binding Treatment}" Width="85" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" />

            <!-- Selected Stage & Failure Detail Pane -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Selected Stage Record" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" Text="{Binding SelectedStageRow.Details, Mode=OneWay}" 
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" FontSize="11" Background="#F8FAFC" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Text="Process Diagnostics / Failure Stderr" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,4" />
                    <TextBox Grid.Row="3" Text="{Binding ProcessFailureDetail, Mode=OneWay}" 
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" FontSize="11" Background="#FFF1F2" Foreground="#991B1B" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="6" HorizontalAlignment="Stretch" Background="#CBD5E1" />

        <!-- 7. Full Log Viewer -->
        <Border Grid.Row="7" Background="#0F172A" CornerRadius="4" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="REAL-TIME LOG STREAM (SECRETS REDACTED)" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="Filter:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <TextBox Text="{Binding LogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="20" FontSize="11" Margin="0,0,8,0" Padding="2,0" />
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <TextBox Grid.Row="1" Text="{Binding FilteredLogText, Mode=OneWay}" 
                         IsReadOnly="True" Background="#020617" Foreground="#F8FAFC"
                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>

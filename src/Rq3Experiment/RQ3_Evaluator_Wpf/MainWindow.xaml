<Window x:Class="RQ3Evaluator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RQ3 Phase 6/7 Control Center" Height="900" Width="1440"
        MinHeight="750" MinWidth="1180" Background="#F1F5F9"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Primary" Color="#0F766E"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#115E59"/>
    <SolidColorBrush x:Key="Accent" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,2,0,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="84"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="46"/>
    </Grid.RowDefinitions>

    <!-- Top App Banner -->
    <Border Background="#134E4A" Grid.Row="0">
      <Grid Margin="24,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="RQ3 Phase 6/7 Control Center" Foreground="#F0FDFA" FontSize="23" FontWeight="Bold"/>
          <TextBlock Text="Technical / exploratory evaluation • 73 evidence-qualified cases • AI-annotated gold • Not a 144-case human-confirmatory study"
                     Foreground="#99F6E4" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="CohortBadge" Background="#115E59" CornerRadius="16" Padding="14,6" Margin="0,0,8,0">
            <TextBlock x:Name="HeaderStatusText" Text="NOT VALIDATED" Foreground="#CCFBF1" FontWeight="Bold" FontSize="12"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content Area: 4 Tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,12,16,8" Background="Transparent" BorderThickness="0">
      
      <!-- TAB 1: Frozen Evidence & Preflight -->
      <TabItem Header="1. Frozen Evidence &amp; Preflight" FontSize="13" FontWeight="SemiBold">
        <Grid Margin="8,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="540"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Input Paths Config -->
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="Repository &amp; Frozen Artifacts"/>
                  
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Workspace Root"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkspacePathBox"/>
                    <Button Grid.Column="1" Click="BrowseWorkspace_Click" Content="Browse"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Dataset Root (Phase 2)"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DatasetPathBox"/>
                    <Button Grid.Column="1" Click="BrowseDataset_Click" Content="Browse"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Frozen Cohort Manifest (Phase 6 Amended)"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ManifestPathBox"/>
                    <Button Grid.Column="1" Click="BrowseManifest_Click" Content="File"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Evidence Bundle Root"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="EvidenceBundlePathBox"/>
                    <Button Grid.Column="1" Click="BrowseEvidenceBundle_Click" Content="Browse"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Tool Evidence Projection Root"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectionPathBox"/>
                    <Button Grid.Column="1" Click="BrowseProjection_Click" Content="Browse"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Evidence Freeze JSON"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="EvidenceFreezePathBox"/>
                    <Button Grid.Column="1" Click="BrowseEvidenceFreeze_Click" Content="File"/>
                  </Grid>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Run Output Root"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathBox"/>
                    <Button Grid.Column="1" Click="BrowseOutput_Click" Content="Browse"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource SectionTitle}" Text="Model &amp; API Configuration" Margin="0"/>
                      <TextBlock x:Name="ModelStatusLabel" Text=" (Ready)" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="RefreshModelsBtn" Grid.Column="1" Click="RefreshModels_Click" Content="↻ Refresh Models" Padding="8,3" FontSize="11" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                  </Grid>

                  <CheckBox x:Name="SameEndpointCheckBox" IsChecked="True" Content="Use same endpoint for all verifiers" FontWeight="Medium" Margin="0,4,0,8" Checked="SameEndpointCheckBox_Changed" Unchecked="SameEndpointCheckBox_Changed"/>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="Shared API Endpoint"/>
                  <TextBox x:Name="SharedEndpointBox" Text="https://openrouter.ai/api/v1/chat/completions" TextChanged="SharedEndpointBox_TextChanged"/>

                  <!-- B1 Configuration -->
                  <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,4">
                    <StackPanel>
                      <TextBlock Text="B1 General Reviewer" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="12" Margin="0,0,0,4"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Endpoint"/>
                      <TextBox x:Name="B1EndpointBox" Text="https://openrouter.ai/api/v1/chat/completions" IsEnabled="False"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                      <ComboBox x:Name="B1ModelBox" IsEditable="True" Text="google/gemini-2.5-flash" MaxDropDownHeight="280"/>
                    </StackPanel>
                  </Border>

                  <!-- B2 Configuration -->
                  <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,4">
                    <StackPanel>
                      <TextBlock Text="B2 Specialized Multi-Agent (3 Specialists)" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="12" Margin="0,0,0,4"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Endpoint"/>
                      <TextBox x:Name="B2EndpointBox" Text="https://openrouter.ai/api/v1/chat/completions" IsEnabled="False"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                      <ComboBox x:Name="B2ModelBox" IsEditable="True" Text="google/gemini-2.5-flash" MaxDropDownHeight="280"/>
                    </StackPanel>
                  </Border>

                  <!-- Stability Configuration -->
                  <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                    <StackPanel>
                      <TextBlock Text="Stability Evaluation" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="12" Margin="0,0,0,4"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Endpoint"/>
                      <TextBox x:Name="StabilityEndpointBox" Text="https://openrouter.ai/api/v1/chat/completions" IsEnabled="False"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                      <ComboBox x:Name="StabilityModelBox" IsEditable="True" Text="google/gemini-2.5-flash" MaxDropDownHeight="280"/>
                    </StackPanel>
                  </Border>

                  <TextBlock Style="{StaticResource FieldLabel}" Text="API Key File (Never logged or passed in CLI)"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiKeyFileBox" IsReadOnly="True" Background="#F8FAFC"/>
                    <Button Grid.Column="1" Click="BrowseApiKey_Click" Content="File"/>
                  </Grid>

                  <!-- API Throttle, Concurrency & Retry -->
                  <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="⚡ API Throttle, Concurrency &amp; Retry" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="12" Margin="0,0,0,6"/>
                      
                      <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Max Tokens / Req"/>
                          <TextBox x:Name="MaxTokensBox" Text="4000" ToolTip="Max tokens for LLM generation (reasoning models require >= 1500 to 4000)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Max Concurrency"/>
                          <TextBox x:Name="MaxConcurrencyBox" Text="5" ToolTip="Max concurrent API calls (e.g., 3-5 for B.AI)"/>
                        </StackPanel>
                      </Grid>

                      <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Rate Limit (RPM)"/>
                          <TextBox x:Name="RateLimitRpmBox" Text="0" ToolTip="Requests per minute limit. Set 0 for no limit, 10 for B.AI."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Max Retries on 429"/>
                          <TextBox x:Name="MaxRetriesBox" Text="3" ToolTip="Number of automatic retries when HTTP 429 rate limit is hit"/>
                        </StackPanel>
                      </Grid>

                      <StackPanel Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Request Timeout (Seconds)"/>
                        <TextBox x:Name="RequestTimeoutSecBox" Text="120" ToolTip="HTTP request timeout in seconds (default 120s)"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Preflight Checklist and Log -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Checklist summary card -->
            <Border Style="{StaticResource Card}" Grid.Row="0">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                  <TextBlock Style="{StaticResource SectionTitle}" Text="Preflight Validation Checklist" DockPanel.Dock="Left"/>
                  <Button x:Name="ValidateButton" Click="Validate_Click" Content="▶ Run Validation" Background="{StaticResource Primary}" Foreground="White" BorderBrush="{StaticResource Primary}" DockPanel.Dock="Right" Padding="16,6"/>
                </DockPanel>

                <UniformGrid Columns="2" Rows="4" Margin="0,4">
                  <TextBlock x:Name="CheckManifestStatus" Text="• Manifest Status: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckCaseCount" Text="• Cases Validated: 0 / 73" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckPublicHashes" Text="• Public Case Hashes: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckBundleHashes" Text="• Evidence Bundle Hashes: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckProjectionHashes" Text="• Projection Hashes: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckFreezeJson" Text="• Evidence Freeze File: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckApiKey" Text="• API Key File: [Pending]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="CheckDocker" Text="• Docker Engine: [Optional]" Margin="4,4" Foreground="{StaticResource TextMuted}"/>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Click="OpenCohortManifest_Click" Content="Open Manifest JSON"/>
                  <Button Click="OpenEvidenceFreeze_Click" Content="Open Evidence Freeze JSON"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Validation Logs -->
            <Border Style="{StaticResource Card}" Grid.Row="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Validation Output Log"/>
                <TextBox x:Name="ValidationLogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Padding="10" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#0F172A" Foreground="#CBD5E1"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- TAB 2: Run Pipeline -->
      <TabItem Header="2. Run Pipeline" FontSize="13" FontWeight="SemiBold">
        <Grid Margin="8,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left: Run Controls & Stage Timeline -->
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Verifier Configuration"/>
                <WrapPanel Margin="0,4,0,10">
                  <CheckBox x:Name="B0Box" IsChecked="True" Content="B0 Basic Tool Gate" Margin="0,4,16,4" FontWeight="Medium"/>
                  <CheckBox x:Name="B1Box" IsChecked="True" Content="B1 General Reviewer" Margin="0,4,16,4" FontWeight="Medium"/>
                  <CheckBox x:Name="B2Box" IsChecked="True" Content="B2 Multi-Agent" Margin="0,4" FontWeight="Medium"/>
                </WrapPanel>
                <TextBlock Text="Target Cohort: 73 evidence-qualified cases" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock x:Name="ActiveRunDirLabel" Text="Run Dir: (Not started)" Foreground="{StaticResource PrimaryDark}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Pipeline Execution Stages"/>

                <Button x:Name="RunPredictionsBtn" Click="RunPredictions_Click" Content="1. Run B0/B1/B2 Predictions" IsEnabled="False"
                        Background="{StaticResource Primary}" Foreground="White" BorderBrush="{StaticResource Primary}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,4"/>
                
                <Button x:Name="FreezePredictionsBtn" Click="FreezePredictions_Click" Content="2. Freeze Predictions (Tamper-evident SHA-256)" IsEnabled="False"
                        HorizontalContentAlignment="Left" Padding="14,10" Margin="0,4"/>

                <Button x:Name="ScoreGoldBtn" Click="ScoreGold_Click" Content="3. Score with Private Gold" IsEnabled="False"
                        Background="#0284C7" Foreground="White" BorderBrush="#0284C7" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,4"/>

                <Button x:Name="RunStabilityBtn" Click="RunStability_Click" Content="4. Run Stability (3-rep on 15 cases)" IsEnabled="False"
                        HorizontalContentAlignment="Left" Padding="14,10" Margin="0,4"/>

                <Separator Margin="0,8"/>

                <Button x:Name="RunAllBtn" Click="RunAllRemaining_Click" Content="⚡ Run All Remaining Stages" IsEnabled="False"
                        Background="#0D9488" Foreground="White" BorderBrush="#0D9488" Padding="14,10" Margin="0,4"/>

                <Button x:Name="ResumeBtn" Click="Resume_Click" Content="🔄 Resume Interrupted Run" IsEnabled="False"
                        Padding="14,8" Margin="0,4"/>

                <Button x:Name="CancelBtn" Click="Cancel_Click" Content="⏹ Cancel Safely" IsEnabled="False"
                        Background="#FEE2E2" Foreground="{StaticResource Danger}" BorderBrush="#FCA5A5" Padding="14,8" Margin="0,4"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Right: Interactive Timeline Visualizer -->
          <Border Style="{StaticResource Card}" Grid.Column="2">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Stage Integrity &amp; Protocol Gate Timeline"/>
              
              <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6">
                <StackPanel>
                  <TextBlock Text="Stage 1: Evidence Preflight" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                  <TextBlock Text="Validates all 73 bundles and projections against frozen SHA-256 hashes. Private gold is untouched." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
              </Border>

              <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6">
                <StackPanel>
                  <TextBlock Text="Stage 2: Model &amp; Tool Predictions" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                  <TextBlock Text="Executes RQ3BatchRunner in subprocess isolation. Produces 219 predictions with incremental checkpoints." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
              </Border>

              <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6">
                <StackPanel>
                  <TextBlock Text="Stage 3: Prediction Freeze" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                  <TextBlock Text="Creates prediction_freeze_v2.json containing SHA-256 of predictions.json. Must complete before gold access." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
              </Border>

              <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6">
                <StackPanel>
                  <TextBlock Text="Stage 4: Private Gold Scoring" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                  <TextBlock Text="Joins private gold annotations, computes decision/routing accuracy, Wilson CI, Clustered Bootstrap CI, and McNemar test." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
              </Border>

              <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6">
                <StackPanel>
                  <TextBlock Text="Stage 5: Output Stability Evaluation" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                  <TextBlock Text="Runs 3 repetitions on 15 stratified cases (90 decision tuples) to quantify output agreement rate." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 3: Live Log & Progress -->
      <TabItem Header="3. Live Log &amp; Progress" FontSize="13" FontWeight="SemiBold">
        <Grid Margin="8,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top Metrics Banner -->
          <UniformGrid Rows="1" Columns="5" Margin="0,0,0,10" Grid.Row="0">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
              <StackPanel><TextBlock Text="STAGE" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="CurrentStageText" Text="IDLE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
              <StackPanel><TextBlock Text="CASES COMPLETED" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="CompletedCasesText" Text="0 / 73" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
              <StackPanel><TextBlock Text="PREDICTIONS" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="CompletedPredsText" Text="0 / 219" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
              <StackPanel><TextBlock Text="API / OUTPUT ERRORS" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="ErrorCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel><TextBlock Text="OBSERVED COST (USD)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="LiveCostText" Text="$0.000000" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/></StackPanel>
            </Border>
          </UniformGrid>

          <!-- Progress Bar & Status Text -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,10" Grid.Row="1" Padding="12,8">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <TextBlock x:Name="ProgressStatusText" Text="Ready to execute pipeline." Foreground="{StaticResource TextMain}" FontWeight="Medium"/>
                <TextBlock x:Name="ElapsedTimeText" DockPanel.Dock="Right" Text="Elapsed: 00:00:00" Foreground="{StaticResource TextMuted}"/>
              </DockPanel>
              <ProgressBar x:Name="ExecutionProgressBar" Grid.Row="1" Height="10" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Primary}"/>
            </Grid>
          </Border>

          <!-- Realtime Console Log Box -->
          <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Execution Console Output (Auto-Scroll)" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <Button Click="CopyLog_Click" Content="Copy Log" Padding="10,4"/>
                  <Button Click="ClearLog_Click" Content="Clear" Padding="10,4"/>
                  <Button Click="OpenActiveRunFolder_Click" Content="Open Run Folder" Padding="10,4"/>
                </StackPanel>
              </DockPanel>
              <TextBox x:Name="ConsoleLogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Padding="10" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                       Background="#0F172A" Foreground="#CBD5E1"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 4: Results & Artifacts Dashboard -->
      <TabItem Header="4. Results &amp; Artifacts" FontSize="13" FontWeight="SemiBold">
        <Grid Margin="8,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Top Action Bar -->
          <Border Style="{StaticResource Card}" Grid.Row="0" Padding="10,8">
            <DockPanel LastChildFill="False">
              <TextBlock Text="Phase 6 Metrics &amp; Audit Artifacts" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMain}"/>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Click="LoadExistingResults_Click" Content="📂 Load Output Folder..."/>
                <Button Click="OpenReportMd_Click" Content="Open Markdown Report"/>
                <Button Click="OpenJoinedCsv_Click" Content="Open Joined CSV"/>
                <Button Click="OpenMetricsJson_Click" Content="Open Metrics JSON"/>
                <Button Click="CopySha256Summary_Click" Content="Copy SHA-256 Hashes"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Verifier Comparison Cards -->
          <UniformGrid Rows="1" Columns="3" Margin="0,0,0,10" Grid.Row="1">
            
            <!-- B0 Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" BorderBrush="#94A3B8">
              <StackPanel>
                <TextBlock Text="B0 BASIC TOOL GATE" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                <TextBlock x:Name="B0AccuracyText" Text="50.68%" FontSize="24" FontWeight="Bold" Foreground="#0F766E" Margin="0,4,0,2"/>
                <TextBlock x:Name="B0CiText" Text="Wilson 95%: [39.5%, 61.8%] • Bootstrap: [40.7%, 59.3%]" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <Separator Margin="0,6"/>
                <TextBlock x:Name="B0RoutingText" Text="Routing Acc: 39.73% • Macro F1: 0.1734" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B0AbstainText" Text="Abstention: 64.38% • Selective Acc: 100.0%" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B0CostText" Text="Errors: 0 • Calls: 0 • Cost: $0.00" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
              </StackPanel>
            </Border>

            <!-- B1 Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" BorderBrush="#94A3B8">
              <StackPanel>
                <TextBlock Text="B1 GENERAL REVIEWER" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                <TextBlock x:Name="B1AccuracyText" Text="58.90%" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,2"/>
                <TextBlock x:Name="B1CiText" Text="Wilson 95%: [47.4%, 69.5%] • Bootstrap: [47.0%, 69.2%]" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <Separator Margin="0,6"/>
                <TextBlock x:Name="B1RoutingText" Text="Routing Acc: 54.79% • Macro F1: 0.2500" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B1AbstainText" Text="Abstention: 41.10% • Selective Acc: 74.42%" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B1CostText" Text="Errors: 4 • Calls: 72 • Cost: $0.073391" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
              </StackPanel>
            </Border>

            <!-- B2 Card -->
            <Border Style="{StaticResource Card}" Margin="0" BorderBrush="#0D9488" BorderThickness="2">
              <StackPanel>
                <TextBlock Text="B2 SPECIALIZED MULTI-AGENT" FontWeight="Bold" Foreground="#0F766E" FontSize="13"/>
                <TextBlock x:Name="B2AccuracyText" Text="65.75%" FontSize="24" FontWeight="Bold" Foreground="#0F766E" Margin="0,4,0,2"/>
                <TextBlock x:Name="B2CiText" Text="Wilson 95%: [54.3%, 75.6%] • Bootstrap: [56.1%, 76.5%]" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <Separator Margin="0,6"/>
                <TextBlock x:Name="B2RoutingText" Text="Routing Acc: 42.47% • Macro F1: 0.1523" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B2AbstainText" Text="Abstention: 20.55% • Selective Acc: 77.59%" FontSize="11" Margin="0,2"/>
                <TextBlock x:Name="B2CostText" Text="Errors: 1 • Calls: 219 • Cost: $0.214728" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Middle Tables: Joined Predictions and Stability -->
          <TabControl Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}">
            
            <TabItem Header="Joined Predictions (73 Cases × 3 Verifiers)">
              <DataGrid x:Name="JoinedResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="160"/>
                  <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="100"/>
                  <DataGridTextColumn Header="Verifier" Binding="{Binding Verifier}" Width="180"/>
                  <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="120"/>
                  <DataGridTextColumn Header="Gold Decision" Binding="{Binding GoldDecision}" Width="120"/>
                  <DataGridCheckBoxColumn Header="Dec Correct" Binding="{Binding DecisionCorrect}" Width="90"/>
                  <DataGridTextColumn Header="Cause" Binding="{Binding Cause}" Width="170"/>
                  <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="160"/>
                  <DataGridTextColumn Header="Gold Category" Binding="{Binding GoldCategory}" Width="200"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding ExecutionStatus}" Width="90"/>
                  <DataGridTextColumn Header="Cost USD" Binding="{Binding CostUsd, StringFormat=F6}" Width="90"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <TabItem Header="Stability Evaluation (3 Repetitions)">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#F8FAFC" Padding="10" Margin="4">
                  <TextBlock x:Name="StabilitySummaryText" Text="Stability Agreement Rate: 94.44% (85/90 agreement tuples across 15 cases • Cost: ~$0.1542 USD)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDark}"/>
                </Border>
                <DataGrid x:Name="StabilityGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" AlternatingRowBackground="#F8FAFC">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Rep" Binding="{Binding Repetition}" Width="50"/>
                    <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="150"/>
                    <DataGridTextColumn Header="Verifier" Binding="{Binding Verifier}" Width="180"/>
                    <DataGridTextColumn Header="Ref Decision" Binding="{Binding ReferenceDecision}" Width="110"/>
                    <DataGridTextColumn Header="Repeat Decision" Binding="{Binding RepeatedDecision}" Width="110"/>
                    <DataGridCheckBoxColumn Header="Agreement" Binding="{Binding TupleAgreement}" Width="90"/>
                    <DataGridTextColumn Header="Ref Cause" Binding="{Binding ReferenceCause}" Width="160"/>
                    <DataGridTextColumn Header="Repeat Cause" Binding="{Binding RepeatedCause}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding ExecutionStatus}" Width="90"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding CostUsd, StringFormat=F6}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Artifact Audit &amp; Hashes">
              <DataGrid x:Name="ArtifactsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Artifact Name" Binding="{Binding Name}" Width="220"/>
                  <DataGridCheckBoxColumn Header="Exists" Binding="{Binding Exists}" Width="60"/>
                  <DataGridTextColumn Header="Size (Bytes)" Binding="{Binding SizeBytes}" Width="100"/>
                  <DataGridTextColumn Header="SHA-256 Hash" Binding="{Binding Sha256}" Width="450"/>
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>

          <!-- Bottom McNemar note -->
          <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,6,0,0" Grid.Row="3">
            <TextBlock x:Name="McNemarSummaryText" Text="Paired McNemar test: B2 vs B0 (p=0.0522, Holm p=0.1045); B2 vs B1 (p=0.4869, Holm p=0.4869). No statistical significance after Holm correction." FontSize="11" Foreground="{StaticResource TextMuted}"/>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,6">
        <TextBlock x:Name="BottomStatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" Text="Ready. Please validate frozen inputs on Tab 1."/>
        <TextBlock x:Name="FooterHashText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11" Text="Phase 6 Protocol • 73 Evidence Cases"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
